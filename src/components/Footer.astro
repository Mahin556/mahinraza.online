---
import { SITE_CONFIG } from '../lib/site';
import { getAllCategories } from '../lib/posts';

const topCategories = getAllCategories().slice(0, 6);
const currentYear = new Date().getUTCFullYear();
---

<footer class="site-footer mt-20 border-t border-slate-800 bg-slate-900 text-slate-300">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <!-- Brand & Bio -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-600 font-mono text-xs font-semibold text-white" aria-hidden="true">
            &gt;_
          </span>
          <span class="font-display text-lg font-bold tracking-tight text-white">
            {SITE_CONFIG.brandName}
          </span>
          <span class="rounded bg-slate-800 px-1.5 py-0.5 font-mono text-[11px] text-teal-400 border border-slate-700">
            ~/blog
          </span>
        </a>
        <p class="mt-4 max-w-md text-sm leading-6 text-slate-400">
          {SITE_CONFIG.description}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-4 text-xs font-medium">
          <a
            href={SITE_CONFIG.portfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-teal-400 hover:text-teal-300 transition-colors"
          >
            <span>mahinraza.online</span>
            <span aria-hidden="true">&nearr;</span>
          </a>
          <span class="text-slate-700" aria-hidden="true">/</span>
          <a
            href={SITE_CONFIG.githubProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-slate-300 hover:text-white transition-colors"
          >
            <span>GitHub (@{SITE_CONFIG.author.username})</span>
          </a>
          <span class="text-slate-700" aria-hidden="true">/</span>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 text-slate-300 hover:text-amber-400 transition-colors"
          >
            <span>RSS</span>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div class="md:col-span-4">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-400">
          // Tracks
        </h3>
        <ul class="mt-4 space-y-2.5">
          {topCategories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}/`}
                class="text-sm text-slate-400 hover:text-white transition-colors"
              >
                {cat.name}
                <span class="ml-1 font-mono text-xs text-slate-500">[{cat.count}]</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-400">
          // Directory
        </h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href="/" class="text-sm text-slate-400 hover:text-white transition-colors">
              All Engineering Blogs
            </a>
          </li>
          <li>
            <a href="/categories/" class="text-sm text-slate-400 hover:text-white transition-colors">
              Categories
            </a>
          </li>
          <li>
            <a href="/tags/" class="text-sm text-slate-400 hover:text-white transition-colors">
              Topic Index
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm text-slate-400 hover:text-white transition-colors">
              RSS Syndication
            </a>
          </li>
          <li>
            <a
              href={SITE_CONFIG.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-slate-400 hover:text-white transition-colors"
            >
              Source Repository
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500">
        &copy; {currentYear} {SITE_CONFIG.brandName}. Content published under{' '}
        <a
          href={`${SITE_CONFIG.repoUrl}/blob/main/LICENSE`}
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-slate-700 hover:text-slate-300"
        >
          CC BY 4.0
        </a>.
      </p>
      <p class="font-mono text-xs text-slate-500">
        blog.mahinraza.online &middot; {SITE_CONFIG.shortRole}
      </p>
    </div>
  </div>
</footer>
