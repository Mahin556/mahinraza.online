---
import { SITE_CONFIG } from '../lib/site';
import { getAllCategories } from '../lib/posts';

const topCategories = getAllCategories().slice(0, 6);
const currentYear = new Date().getUTCFullYear();
---

<footer class="site-footer mt-20 border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <!-- Brand & Bio -->
      <div class="md:col-span-5">
        <a href="/" class="inline-flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gray-900 text-white font-bold text-sm tracking-tight">
            MR
          </span>
          <span class="text-lg font-bold tracking-tight text-gray-900">
            {SITE_CONFIG.brandName}
          </span>
        </a>
        <p class="mt-4 max-w-md text-sm leading-6 text-gray-600">
          {SITE_CONFIG.description}
        </p>
        <div class="mt-5 flex items-center gap-4">
          <a
            href={SITE_CONFIG.githubProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
          <span class="text-gray-300" aria-hidden="true">·</span>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-orange-600 transition-colors"
          >
            <svg class="h-4 w-4 text-orange-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
            </svg>
            <span>RSS Feed</span>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div class="md:col-span-4">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-900">
          Categories
        </h3>
        <ul class="mt-4 space-y-2.5">
          {topCategories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}/`}
                class="text-sm text-gray-600 hover:text-blue-600 transition-colors"
              >
                {cat.name}
                <span class="ml-1 text-xs text-gray-400">({cat.count})</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-900">
          Explore
        </h3>
        <ul class="mt-4 space-y-2.5">
          <li>
            <a href="/" class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
              All Articles
            </a>
          </li>
          <li>
            <a href="/categories/" class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
              Browse Categories
            </a>
          </li>
          <li>
            <a href="/tags/" class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
              Browse Tags
            </a>
          </li>
          <li>
            <a href="/rss.xml" class="text-sm text-gray-600 hover:text-blue-600 transition-colors">
              RSS Feed
            </a>
          </li>
          <li>
            <a
              href={SITE_CONFIG.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-gray-600 hover:text-blue-600 transition-colors"
            >
              Source Repository
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-gray-100 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        &copy; {currentYear} {SITE_CONFIG.brandName}. All rights reserved.
      </p>
      <p class="text-xs text-gray-400">
        blog.mahinraza.online &middot; DevOps &amp; Cloud Engineering
      </p>
    </div>
  </div>
</footer>
