---
import type { TocItem } from '../lib/markdown';

interface Props {
  items: TocItem[];
  variant: 'mobile' | 'desktop';
}

const { items, variant } = Astro.props;
---

{items.length > 0 && variant === 'mobile' && (
  <details class="xl:hidden my-6 rounded-2xl border border-gray-200 bg-gray-50/70 p-4 shadow-sm">
    <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-gray-900 select-none">
      <span class="inline-flex items-center gap-2">
        <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h14" />
        </svg>
        <span>On this page</span>
        <span class="rounded-full bg-white px-2 py-0.5 text-xs font-medium text-gray-500 border border-gray-200">
          {items.length}
        </span>
      </span>
      <svg class="h-4 w-4 text-gray-400 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <nav class="toc-nav mt-3 border-t border-gray-200/80 pt-3 max-h-72 overflow-y-auto" aria-label="Table of contents">
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-link={item.id}
          class={item.level === 3 ? 'toc-h3' : ''}
        >
          {item.text}
        </a>
      ))}
    </nav>
  </details>
)}

{items.length > 0 && variant === 'desktop' && (
  <aside class="floating-toc-aside hidden xl:block w-56 shrink-0" aria-label="Table of contents">
    <div class="sticky top-28">
      <div class="floating-toc-inner">
        <div class="mb-2.5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-gray-900">
          <svg class="h-3.5 w-3.5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h14" />
          </svg>
          <span>On this page</span>
        </div>
        <nav class="toc-nav max-h-[65vh] overflow-y-auto pr-1">
          {items.map((item) => (
            <a
              href={`#${item.id}`}
              data-toc-link={item.id}
              class={item.level === 3 ? 'toc-h3' : ''}
            >
              {item.text}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </aside>
)}
