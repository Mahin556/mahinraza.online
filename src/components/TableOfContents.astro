---
import type { TocItem } from '../lib/markdown';

interface Props {
  items: TocItem[];
  variant: 'mobile' | 'desktop';
}

const { items, variant } = Astro.props;
---

{items.length > 0 && variant === 'mobile' && (
  <details class="xl:hidden my-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-slate-900 select-none">
      <span class="inline-flex items-center gap-2">
        <span class="font-mono text-xs text-teal-600" aria-hidden="true">//</span>
        <span>Contents</span>
        <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[11px] font-medium text-slate-500">
          {items.length}
        </span>
      </span>
      <svg class="h-4 w-4 text-slate-400 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <nav class="toc-nav mt-3 pt-2 max-h-72 overflow-y-auto" aria-label="Table of contents">
      {items.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-link={item.id}
          class={item.level === 3 ? 'toc-h3' : ''}
        >
          {item.text}
        </a>
      ))}
    </nav>
  </details>
)}

{items.length > 0 && variant === 'desktop' && (
  <aside class="floating-toc-aside hidden xl:block w-60 shrink-0" aria-label="Table of contents">
    <div class="sticky top-24">
      <div class="mb-3 flex items-center gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500">
        <span class="text-teal-600" aria-hidden="true">//</span>
        <span>On this page</span>
      </div>
      <nav class="toc-nav max-h-[68vh] overflow-y-auto pr-2">
        {items.map((item) => (
          <a
            href={`#${item.id}`}
            data-toc-link={item.id}
            class={item.level === 3 ? 'toc-h3' : ''}
          >
            {item.text}
          </a>
        ))}
      </nav>
    </div>
  </aside>
)}
