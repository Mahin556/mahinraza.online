---
import type { BlogPost } from '../lib/posts';
import TagPills from './TagPills.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-7 sm:p-10 md:p-12 shadow-sm ring-1 ring-gray-100 transition-all duration-200 hover:border-blue-200 hover:shadow-lg hover:ring-blue-100">
  <!-- Subtle light-theme gradient accent -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-br from-blue-50/40 via-white to-sky-50/30 opacity-80 group-hover:opacity-100 transition-opacity"
    aria-hidden="true"
  ></div>

  <div class="relative z-10">
    <!-- Top Badges -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 font-semibold text-blue-700">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        Featured
      </span>

      <a
        href={`/category/${post.categorySlug}/`}
        class="inline-flex items-center rounded-full border border-gray-200 bg-white px-3 py-1 font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
      >
        {post.category}
      </a>

      <span class="text-gray-500">
        {post.formattedDate} &middot; {post.readingTimeText}
      </span>
    </div>

    <!-- Title -->
    <h2 class="mt-5 text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-gray-900 group-hover:text-blue-600 transition-colors leading-tight">
      <a href={`/posts/${post.slug}/`}>
        {post.title}
      </a>
    </h2>

    <!-- Description -->
    <p class="mt-4 max-w-3xl text-base sm:text-lg leading-relaxed text-gray-600">
      {post.description}
    </p>

    <!-- Tags -->
    <div class="mt-6">
      <TagPills tags={post.tags} limit={6} size="md" />
    </div>

    <!-- Footer: Author & Read CTA -->
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-gray-100 pt-6">
      <a
        href={post.author.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 group/author"
      >
        <img
          src={post.author.avatarUrl}
          alt={post.author.name}
          width="36"
          height="36"
          loading="eager"
          decoding="async"
          class="h-9 w-9 rounded-full bg-gray-100 ring-1 ring-gray-200 object-cover"
        />
        <div class="text-left">
          <div class="text-sm font-semibold text-gray-900 group-hover/author:text-blue-600 transition-colors">
            {post.author.name}
          </div>
          <div class="text-xs text-gray-500">
            @{post.author.username}
          </div>
        </div>
      </a>

      <a
        href={`/posts/${post.slug}/`}
        class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors"
      >
        <span>Read article</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>
  </div>
</article>
