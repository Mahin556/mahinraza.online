---
import type { BlogPost } from '../lib/posts';
import TagPills from './TagPills.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="group relative overflow-hidden rounded-xl border border-slate-200/90 border-l-4 border-l-teal-600 bg-white p-6 sm:p-8 md:p-10 shadow-sm transition-all duration-200 hover:border-slate-300 hover:border-l-teal-500 hover:shadow-md">
  <div class="relative z-10 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-9">
      <!-- Top Metadata Strip -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-md bg-teal-50 border border-teal-200/80 px-2.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-teal-800">
          Latest Dispatch
        </span>

        <a
          href={`/category/${post.categorySlug}/`}
          class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 font-medium text-slate-700 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800 transition-colors"
        >
          {post.category}
        </a>

        <span class="font-mono text-[11px] text-slate-500">
          {post.formattedDate} &middot; {post.readingTimeText}
        </span>
      </div>

      <!-- Title -->
      <h2 class="mt-4 font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 group-hover:text-teal-700 transition-colors leading-snug">
        <a href={`/posts/${post.slug}/`}>
          {post.title}
        </a>
      </h2>

      <!-- Description -->
      <p class="mt-3 max-w-3xl text-sm sm:text-base leading-relaxed text-slate-600">
        {post.description}
      </p>

      <!-- Tags -->
      <div class="mt-5">
        <TagPills tags={post.tags} limit={6} size="md" />
      </div>
    </div>

    <!-- Right Column Action Panel -->
    <div class="flex flex-row lg:flex-col items-center lg:items-end justify-between gap-4 border-t lg:border-t-0 lg:border-l border-slate-100 pt-5 lg:pt-0 lg:pl-6 lg:col-span-3">
      <div class="text-left lg:text-right">
        <div class="font-mono text-[11px] uppercase tracking-wider text-slate-400">
          Author
        </div>
        <div class="mt-0.5 text-sm font-semibold text-slate-800">
          {post.author.name}
        </div>
      </div>

      <a
        href={`/posts/${post.slug}/`}
        class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-teal-700 transition-colors"
      >
        <span>Read guide</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>
  </div>
</article>
