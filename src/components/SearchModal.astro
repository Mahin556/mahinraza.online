---
---

<!-- Global Client-Side Search Modal -->
<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-gray-900/40 backdrop-blur-sm px-4 pt-16 sm:pt-24"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-label"
>
  <div
    class="w-full max-w-2xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl ring-1 ring-gray-900/5"
    id="search-modal-panel"
  >
    <!-- Search Input Bar -->
    <div class="flex items-center gap-3 border-b border-gray-100 px-4 py-3.5">
      <svg class="h-5 w-5 shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <label id="search-modal-label" for="search-modal-input" class="sr-only">
        Search articles by title, tag, category, or topic
      </label>
      <input
        id="search-modal-input"
        type="search"
        autocomplete="off"
        placeholder="Search articles, Kubernetes, AWS, Prometheus, OpenTelemetry..."
        class="w-full border-0 bg-transparent text-base text-gray-900 placeholder:text-gray-400 focus:outline-none focus:ring-0"
      />
      <button
        type="button"
        id="search-modal-close"
        class="rounded-lg border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors"
      >
        ESC
      </button>
    </div>

    <!-- Results Container -->
    <div id="search-modal-results" class="max-h-[60vh] overflow-y-auto p-3">
      <div class="py-10 text-center text-sm text-gray-500">
        Type to search across all DevOps &amp; Cloud Engineering articles.
      </div>
    </div>

    <!-- Footer Hint -->
    <div class="flex items-center justify-between border-t border-gray-100 bg-gray-50/70 px-4 py-2.5 text-xs text-gray-500">
      <div class="flex items-center gap-3">
        <span><kbd class="rounded border border-gray-200 bg-white px-1.5 py-0.5 font-mono text-[10px]">↑↓</kbd> Navigate</span>
        <span><kbd class="rounded border border-gray-200 bg-white px-1.5 py-0.5 font-mono text-[10px]">↵</kbd> Open</span>
      </div>
      <span id="search-modal-count"></span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('search-modal');
    const panel = document.getElementById('search-modal-panel');
    const input = document.getElementById('search-modal-input');
    const closeBtn = document.getElementById('search-modal-close');
    const resultsEl = document.getElementById('search-modal-results');
    const countEl = document.getElementById('search-modal-count');

    if (!modal || !input || !resultsEl) return;

    let searchIndex = null;
    let loadingPromise = null;
    let activeIdx = -1;
    let currentMatches = [];

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    async function ensureIndexLoaded() {
      if (searchIndex) return searchIndex;
      if (!loadingPromise) {
        loadingPromise = fetch('/search-index.json')
          .then((r) => r.json())
          .then((data) => {
            searchIndex = Array.isArray(data) ? data : [];
            return searchIndex;
          })
          .catch(() => {
            searchIndex = [];
            return searchIndex;
          });
      }
      return loadingPromise;
    }

    function openModal(prefill) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      ensureIndexLoaded().then(() => {
        if (typeof prefill === 'string') {
          input.value = prefill;
        }
        renderResults(input.value);
        input.focus();
      });
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
      activeIdx = -1;
    }

    function scoreItem(item, terms) {
      let score = 0;
      const titleLower = item.title.toLowerCase();
      const descLower = item.description.toLowerCase();
      const catLower = item.category.toLowerCase();
      const tagsLower = item.tags.map((t) => t.toLowerCase());

      for (const term of terms) {
        let matchedTerm = false;
        if (titleLower.includes(term)) {
          score += titleLower.startsWith(term) ? 12 : 8;
          matchedTerm = true;
        }
        if (tagsLower.some((t) => t.includes(term))) {
          score += 6;
          matchedTerm = true;
        }
        if (catLower.includes(term)) {
          score += 4;
          matchedTerm = true;
        }
        if (descLower.includes(term)) {
          score += 2;
          matchedTerm = true;
        }
        if (!matchedTerm) return 0;
      }
      return score;
    }

    function renderResults(rawQuery) {
      if (!searchIndex) {
        resultsEl.innerHTML = '<div class="py-10 text-center text-sm text-gray-500">Loading search index...</div>';
        return;
      }

      const query = (rawQuery || '').trim().toLowerCase();
      if (!query) {
        currentMatches = searchIndex.slice(0, 8);
        if (countEl) countEl.textContent = searchIndex.length + ' total articles';
      } else {
        const terms = query.split(/\s+/).filter(Boolean);
        currentMatches = searchIndex
          .map((item) => ({ item, score: scoreItem(item, terms) }))
          .filter((entry) => entry.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 15)
          .map((entry) => entry.item);

        if (countEl) {
          countEl.textContent =
            currentMatches.length === 1
              ? '1 match'
              : currentMatches.length + ' matches';
        }
      }

      activeIdx = currentMatches.length > 0 ? 0 : -1;

      if (currentMatches.length === 0) {
        resultsEl.innerHTML =
          '<div class="py-10 text-center text-sm text-gray-500">No articles found matching <strong class="text-gray-900">"' +
          escapeHtml(rawQuery) +
          '"</strong>.</div>';
        return;
      }

      const headingLabel = query
        ? ''
        : '<div class="px-3 pt-1 pb-2 text-xs font-semibold uppercase tracking-wider text-gray-400">Latest Articles</div>';

      resultsEl.innerHTML =
        headingLabel +
        currentMatches
          .map((item, idx) => {
            const activeClass =
              idx === activeIdx
                ? 'bg-blue-50/80 border-blue-200'
                : 'bg-white border-transparent hover:bg-gray-50';
            const tagBadges = item.tags
              .slice(0, 3)
              .map(
                (t) =>
                  '<span class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-2 py-0.5 text-[11px] font-medium text-gray-600">' +
                  escapeHtml(t) +
                  '</span>'
              )
              .join('');

            return (
              '<a href="/posts/' +
              encodeURIComponent(item.slug) +
              '/" data-search-result-idx="' +
              idx +
              '" class="block rounded-xl border p-3.5 transition-colors ' +
              activeClass +
              '">' +
              '<div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-1">' +
              '<span class="font-medium text-blue-600">' +
              escapeHtml(item.category) +
              '</span>' +
              '<span>' +
              escapeHtml(item.formattedDate) +
              ' &middot; ' +
              escapeHtml(item.readingTimeText) +
              '</span>' +
              '</div>' +
              '<div class="text-sm font-semibold text-gray-900">' +
              escapeHtml(item.title) +
              '</div>' +
              '<p class="mt-1 line-clamp-1 text-xs text-gray-600">' +
              escapeHtml(item.description) +
              '</p>' +
              '<div class="mt-2 flex flex-wrap gap-1.5">' +
              tagBadges +
              '</div>' +
              '</a>'
            );
          })
          .join('');
    }

    function updateHighlight() {
      const links = resultsEl.querySelectorAll('[data-search-result-idx]');
      links.forEach((el, idx) => {
        if (idx === activeIdx) {
          el.classList.add('bg-blue-50/80', 'border-blue-200');
          el.classList.remove('bg-white', 'border-transparent');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-blue-50/80', 'border-blue-200');
          el.classList.add('bg-white', 'border-transparent');
        }
      });
    }

    document.querySelectorAll('[data-open-search]').forEach((btn) => {
      btn.addEventListener('click', () => openModal());
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    modal.addEventListener('click', (e) => {
      if (panel && !panel.contains(e.target)) {
        closeModal();
      }
    });

    input.addEventListener('input', () => {
      renderResults(input.value);
    });

    document.addEventListener('keydown', (e) => {
      const isModalOpen = !modal.classList.contains('hidden');

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isModalOpen) closeModal();
        else openModal();
        return;
      }

      if (
        e.key === '/' &&
        !isModalOpen &&
        document.activeElement &&
        !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName) &&
        !document.activeElement.isContentEditable
      ) {
        e.preventDefault();
        openModal();
        return;
      }

      if (!isModalOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentMatches.length > 0) {
          activeIdx = (activeIdx + 1) % currentMatches.length;
          updateHighlight();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentMatches.length > 0) {
          activeIdx = (activeIdx - 1 + currentMatches.length) % currentMatches.length;
          updateHighlight();
        }
      } else if (e.key === 'Enter' && activeIdx >= 0 && currentMatches[activeIdx]) {
        e.preventDefault();
        window.location.href = '/posts/' + encodeURIComponent(currentMatches[activeIdx].slug) + '/';
      }
    });

    window.__openBlogSearch = openModal;
  })();
</script>
