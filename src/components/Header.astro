---
import { SITE_CONFIG } from '../lib/site';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Blogs', active: pathname === '/' || pathname.startsWith('/page/') || pathname.startsWith('/posts/') },
  { href: '/categories/', label: 'Categories', active: pathname.startsWith('/categories') || pathname.startsWith('/category/') },
  { href: '/tags/', label: 'Topics', active: pathname.startsWith('/tags') || pathname.startsWith('/tag/') },
];
---

<header class="site-header sticky top-0 z-40 border-t-2 border-t-teal-600 dark:border-t-teal-500 border-b border-slate-200/80 dark:border-b-slate-800/90 bg-white/95 dark:bg-[#0b1120]/90 backdrop-blur-md transition-colors">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Left: Brand + Primary Nav -->
      <div class="flex items-center gap-8">
        <a href="/" class="group inline-flex items-center gap-2.5 focus:outline-none">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-900 dark:bg-teal-500/15 font-mono text-xs font-semibold text-teal-400 shadow-sm ring-1 ring-slate-900/10 dark:ring-teal-500/30 group-hover:bg-teal-700 group-hover:text-white dark:group-hover:bg-teal-500 dark:group-hover:text-slate-950 transition-colors" aria-hidden="true">
            &gt;_
          </span>
          <span class="flex items-baseline gap-1.5">
            <span class="font-display text-base sm:text-[17px] font-bold tracking-tight text-slate-900 dark:text-slate-100 group-hover:text-teal-700 dark:group-hover:text-teal-400 transition-colors">
              {SITE_CONFIG.brandName}
            </span>
            <span class="hidden sm:inline-block rounded bg-slate-100 dark:bg-slate-800/90 px-1.5 py-0.5 font-mono text-[11px] font-medium text-slate-500 dark:text-slate-400 border border-slate-200/80 dark:border-slate-700">
              ~/blog
            </span>
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
          {navLinks.map((item) => (
            <a
              href={item.href}
              class={`rounded-lg px-3 py-1.5 text-sm font-medium transition-colors ${
                item.active
                  ? 'bg-teal-50/90 text-teal-800 dark:bg-teal-500/15 dark:text-teal-300 font-semibold'
                  : 'text-slate-600 hover:bg-slate-100/80 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800/80 dark:hover:text-white'
              }`}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Right: Search + Theme Toggle + Portfolio + RSS + GitHub + Mobile Menu -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-open-search
          aria-label="Search articles"
          class="inline-flex items-center gap-2 rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50/90 dark:bg-slate-900/90 px-2.5 sm:px-3 py-1.5 text-xs sm:text-sm text-slate-500 dark:text-slate-400 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-slate-100 transition-all"
        >
          <svg class="h-4 w-4 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search...</span>
          <kbd class="hidden lg:inline-flex items-center rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-1.5 py-0.5 font-mono text-[10px] font-medium text-slate-400">
            /
          </kbd>
        </button>

        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle color theme"
          title="Toggle dark / light theme"
          class="inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-white dark:bg-slate-900/90 p-1.5 text-slate-600 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-teal-50/60 dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
        >
          <!-- Sun icon (shown when dark mode is active) -->
          <svg class="hidden h-4 w-4 dark:block text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <!-- Moon icon (shown when light mode is active) -->
          <svg class="block h-4 w-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <a
          href={SITE_CONFIG.portfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden lg:inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
        >
          <span>Portfolio</span>
          <svg class="h-3.5 w-3.5 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
          </svg>
        </a>

        <a
          href="/rss.xml"
          title="RSS Feed"
          aria-label="RSS Feed"
          class="hidden sm:inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-white dark:bg-slate-900/90 p-1.5 text-slate-500 dark:text-slate-400 hover:border-amber-300 dark:hover:border-amber-500/50 hover:bg-amber-50 dark:hover:bg-amber-950/40 hover:text-amber-700 dark:hover:text-amber-400 transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
          </svg>
        </a>

        <a
          href={SITE_CONFIG.githubProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Mahin Raza on GitHub"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-slate-900 dark:bg-slate-800 dark:border dark:border-slate-700 px-3 py-1.5 text-xs font-semibold text-white dark:text-slate-100 shadow-sm hover:bg-teal-700 dark:hover:bg-teal-600 dark:hover:border-teal-500 transition-colors"
        >
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span class="font-mono">@{SITE_CONFIG.author.username}</span>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
          class="md:hidden inline-flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-white dark:bg-slate-900/90 p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors"
        >
          <svg id="menu-icon-open" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 px-6 py-4 shadow-lg">
    <nav class="flex flex-col space-y-1.5" aria-label="Mobile Primary">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
            item.active
              ? 'bg-teal-50 text-teal-800 dark:bg-teal-500/15 dark:text-teal-300 font-semibold'
              : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/rss.xml"
        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white transition-colors"
      >
        RSS Feed
      </a>
      <div class="pt-3 mt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-4">
        <a
          href={SITE_CONFIG.portfolioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-teal-700 hover:text-teal-800 dark:text-teal-400 dark:hover:text-teal-300"
        >
          mahinraza.online &nearr;
        </a>
        <a
          href={SITE_CONFIG.githubProfileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100"
        >
          <span>GitHub @{SITE_CONFIG.author.username}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (toggleBtn && menu && openIcon && closeIcon) {
      toggleBtn.addEventListener('click', function () {
        const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden', expanded);
        openIcon.classList.toggle('hidden', !expanded);
        closeIcon.classList.toggle('hidden', expanded);
      });
    }

    const themeButtons = document.querySelectorAll('[data-theme-toggle]');
    function syncThemeAria() {
      const isDark = document.documentElement.classList.contains('dark');
      const label = isDark ? 'Switch to light theme' : 'Switch to dark theme';
      themeButtons.forEach(function (btn) {
        btn.setAttribute('aria-label', label);
        btn.setAttribute('title', label);
      });
    }

    syncThemeAria();

    themeButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const root = document.documentElement;
        const nextIsDark = !root.classList.contains('dark');
        root.classList.toggle('dark', nextIsDark);
        root.style.colorScheme = nextIsDark ? 'dark' : 'light';
        try {
          localStorage.setItem('blog-theme', nextIsDark ? 'dark' : 'light');
        } catch (_) {}
        const metaTheme = document.getElementById('meta-theme-color');
        if (metaTheme) {
          metaTheme.setAttribute('content', nextIsDark ? '#0b1120' : '#0f766e');
        }
        syncThemeAria();
      });
    });
  })();
</script>
