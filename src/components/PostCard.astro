---
import type { BlogPost } from '../lib/posts';
import { getCardAccent } from '../lib/colors';
import TagPills from './TagPills.astro';

interface Props {
  post: BlogPost;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const accent = getCardAccent(index);
---

<article
  data-post-card
  data-category={post.categorySlug}
  data-search={`${post.title} ${post.description} ${post.category} ${post.tags.join(' ')}`.toLowerCase()}
  class={`group relative flex flex-col justify-between overflow-hidden rounded-xl border border-slate-200/90 bg-white p-5 sm:p-6 shadow-[0_1px_3px_rgba(15,23,42,0.03)] transition-all duration-200 hover:-translate-y-0.5 ${accent.cardHover}`}
>
  <!-- Crisp top accent indicator on hover -->
  <div
    class={`pointer-events-none absolute inset-x-0 top-0 h-0.5 bg-transparent transition-colors duration-200 ${accent.topBar}`}
    aria-hidden="true"
  ></div>

  <div class="flex flex-col flex-1">
    <!-- Category + Date -->
    <div class="flex items-center justify-between gap-2 text-xs">
      <a
        href={`/category/${post.categorySlug}/`}
        class="inline-flex items-center rounded-md border border-slate-200/80 bg-slate-50 px-2 py-0.5 font-medium text-slate-700 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800 transition-colors truncate"
      >
        {post.category}
      </a>
      <time datetime={post.dateISO} class="shrink-0 font-mono text-[11px] text-slate-400">
        {post.formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h2 class={`mt-3.5 font-display text-[17px] font-bold tracking-tight text-slate-900 transition-colors leading-snug ${accent.titleHover}`}>
      <a href={`/posts/${post.slug}/`} class="focus:outline-none">
        {post.title}
      </a>
    </h2>

    <!-- Description -->
    <p class="mt-2.5 line-clamp-3 text-sm leading-6 text-slate-600 flex-1">
      {post.description}
    </p>

    <!-- Tags -->
    <div class="mt-4">
      <TagPills tags={post.tags} limit={3} size="sm" />
    </div>
  </div>

  <!-- Card Footer: Reading Time + Read Link -->
  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-3.5">
    <span class="font-mono text-[11px] text-slate-400">
      {post.readingTimeText}
    </span>

    <a
      href={`/posts/${post.slug}/`}
      class={`inline-flex items-center gap-1 text-xs font-semibold transition-colors ${accent.cta}`}
    >
      <span>Read guide</span>
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </a>
  </div>
</article>
