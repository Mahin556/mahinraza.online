---
import { getTagAccent } from '../lib/colors';
import { slugifyTerm } from '../lib/posts';

interface Props {
  tags: string[];
  limit?: number;
  size?: 'sm' | 'md';
}

const { tags, limit, size = 'sm' } = Astro.props;
const visibleTags = typeof limit === 'number' ? tags.slice(0, limit) : tags;
const remaining = typeof limit === 'number' ? Math.max(0, tags.length - limit) : 0;
const sizeClasses =
  size === 'md'
    ? 'px-2.5 py-1 text-xs'
    : 'px-2 py-0.5 text-[11px]';
---

{visibleTags.length > 0 && (
  <div class="flex flex-wrap items-center gap-1.5">
    {visibleTags.map((tag) => {
      const accent = getTagAccent(tag);
      return (
        <a
          href={`/tag/${slugifyTerm(tag)}/`}
          class={`inline-flex items-center rounded-md border font-mono font-medium transition-colors ${sizeClasses} ${accent.pill}`}
        >
          <span class="mr-0.5 opacity-60" aria-hidden="true">#</span>
          <span>{tag}</span>
        </a>
      );
    })}
    {remaining > 0 && (
      <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-500">
        +{remaining}
      </span>
    )}
  </div>
)}
