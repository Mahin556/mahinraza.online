---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';
import { getTagAccent } from '../../lib/colors';

const tags = getAllTags();
---

<BaseLayout
  title="Topics"
  description="Browse all technical topics and tags across AWS, Kubernetes, Prometheus, OpenTelemetry, and SRE."
  breadcrumbs={[
    { name: 'Blogs', url: '/' },
    { name: 'Topics' },
  ]}
>
  <section class="border-b border-slate-200/80 bg-white py-12 sm:py-14">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="max-w-2xl">
          <span class="inline-flex items-center rounded-md border border-teal-200 bg-teal-50 px-2.5 py-1 font-mono text-xs font-medium text-teal-800">
            ~/topics &middot; {tags.length} tags
          </span>
          <h1 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
            Topic Index
          </h1>
          <p class="mt-3 text-base sm:text-lg leading-7 text-slate-600">
            Filter engineering blogs by cloud service, Kubernetes component, telemetry signal, or SRE pattern.
          </p>
        </div>

        <div class="w-full md:w-72">
          <label for="tag-filter-input" class="sr-only">Filter topics</label>
          <input
            id="tag-filter-input"
            type="search"
            placeholder="Filter topics..."
            class="w-full rounded-lg border border-slate-200 bg-slate-50/80 px-3.5 py-2.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-100"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div id="tags-directory" class="flex flex-wrap gap-2.5">
      {tags.map((tag) => {
        const accent = getTagAccent(tag.name);
        return (
          <a
            href={`/tag/${tag.slug}/`}
            data-tag-item={tag.name.toLowerCase()}
            class={`inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 font-mono text-xs font-medium shadow-sm transition-all hover:-translate-y-0.5 ${accent.pill}`}
          >
            <span class="opacity-60" aria-hidden="true">#</span>
            <span>{tag.name}</span>
            <span class="ml-0.5 rounded bg-white/90 px-1.5 py-0.5 text-[10px] font-semibold text-slate-500">
              {tag.count}
            </span>
          </a>
        );
      })}
    </div>

    <p id="tags-empty-msg" class="hidden py-12 text-center text-sm text-slate-500">
      No topics match your filter.
    </p>
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById('tag-filter-input');
      const items = document.querySelectorAll('[data-tag-item]');
      const emptyMsg = document.getElementById('tags-empty-msg');
      if (!input || !items.length) return;

      input.addEventListener('input', function () {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        items.forEach((el) => {
          const name = el.getAttribute('data-tag-item') || '';
          const match = !q || name.includes(q);
          el.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', visible > 0);
        }
      });
    })();
  </script>
</BaseLayout>
