---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';
import { getTagAccent } from '../../lib/colors';

const tags = getAllTags();
---

<BaseLayout
  title="Tags"
  description="Browse all technical topics and tags across AWS, Kubernetes, Prometheus, OpenTelemetry, and SRE."
  breadcrumbs={[
    { name: 'Articles', url: '/' },
    { name: 'Tags' },
  ]}
>
  <section class="border-b border-gray-100 bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div class="max-w-2xl">
          <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
            {tags.length} Topics
          </span>
          <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
            Browse by Tag
          </h1>
          <p class="mt-3 text-base sm:text-lg leading-7 text-gray-600">
            Filter articles by technology, AWS service, observability tool, or operational pattern.
          </p>
        </div>

        <div class="w-full md:w-72">
          <label for="tag-filter-input" class="sr-only">Filter tags</label>
          <input
            id="tag-filter-input"
            type="search"
            placeholder="Filter tags..."
            class="w-full rounded-xl border border-gray-200 bg-gray-50/70 px-4 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div id="tags-directory" class="flex flex-wrap gap-3">
      {tags.map((tag) => {
        const accent = getTagAccent(tag.name);
        return (
          <a
            href={`/tag/${tag.slug}/`}
            data-tag-item={tag.name.toLowerCase()}
            class={`inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium shadow-sm transition-all hover:-translate-y-0.5 ${accent.pill}`}
          >
            <span class={`h-2 w-2 rounded-full ${accent.dot}`} aria-hidden="true"></span>
            <span>{tag.name}</span>
            <span class="rounded-full bg-white/80 px-2 py-0.5 text-xs font-semibold text-gray-600">
              {tag.count}
            </span>
          </a>
        );
      })}
    </div>

    <p id="tags-empty-msg" class="hidden py-12 text-center text-sm text-gray-500">
      No tags match your filter.
    </p>
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById('tag-filter-input');
      const items = document.querySelectorAll('[data-tag-item]');
      const emptyMsg = document.getElementById('tags-empty-msg');
      if (!input || !items.length) return;

      input.addEventListener('input', function () {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        items.forEach((el) => {
          const name = el.getAttribute('data-tag-item') || '';
          const match = !q || name.includes(q);
          el.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', visible > 0);
        }
      });
    })();
  </script>
</BaseLayout>
