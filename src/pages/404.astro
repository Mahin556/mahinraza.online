---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found."
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-6 py-24 sm:py-32 text-center">
    <span class="inline-flex items-center rounded-md border border-teal-200 bg-teal-50 px-2.5 py-1 font-mono text-xs font-semibold text-teal-800">
      HTTP 404
    </span>
    <h1 class="mt-5 font-display text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900">
      Route not found
    </h1>
    <p class="mt-4 text-base sm:text-lg leading-7 text-slate-600">
      The engineering blog or path you requested doesn&rsquo;t exist. Try searching across all DevOps &amp; Cloud Engineering blogs below.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-teal-700 transition-colors"
      >
        <span>&larr; Back to all blogs</span>
      </a>
      <button
        type="button"
        data-open-search
        class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:border-teal-300 hover:text-slate-900 transition-colors"
      >
        <svg class="h-4 w-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search blogs</span>
      </button>
    </div>
  </section>
</BaseLayout>
