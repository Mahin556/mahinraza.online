---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_CONFIG } from '../../lib/site';
import { loadAllPosts } from '../../lib/posts';

export function getStaticPaths() {
  const allPosts = loadAllPosts();
  const remainingPosts = allPosts.slice(1);
  const perPage = SITE_CONFIG.postsPerPage;
  const totalPages = Math.ceil(remainingPosts.length / perPage);

  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * perPage;
    const pagePosts = remainingPosts.slice(start, start + perPage);
    paths.push({
      params: { page: String(page) },
      props: {
        posts: pagePosts,
        currentPage: page,
        totalPages,
      },
    });
  }
  return paths;
}

interface Props {
  posts: ReturnType<typeof loadAllPosts>;
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
const prevHref = currentPage === 2 ? '/' : `/page/${currentPage - 1}/`;
const nextHref = currentPage < totalPages ? `/page/${currentPage + 1}/` : null;
---

<BaseLayout
  title={`Articles — Page ${currentPage}`}
  description={`Page ${currentPage} of ${totalPages} — DevOps and Cloud Engineering articles by ${SITE_CONFIG.brandName}.`}
  breadcrumbs={[
    { name: 'Articles', url: '/' },
    { name: `Page ${currentPage}` },
  ]}
>
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="mb-10 border-b border-gray-100 pb-8">
      <a href="/" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500">
        <span>&larr; Back to latest</span>
      </a>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-gray-900">
        Engineering Articles &mdash; Page {currentPage}
      </h1>
      <p class="mt-2 text-sm text-gray-500">
        Showing page {currentPage} of {totalPages}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, idx) => (
        <PostCard post={post} index={idx} />
      ))}
    </div>

    <!-- Pagination -->
    <nav aria-label="Pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2">
      <a
        href={prevHref}
        class="inline-flex items-center gap-1 rounded-xl border border-gray-200 bg-white px-4 h-10 text-sm font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
      >
        <span aria-hidden="true">&larr;</span>
        <span>Previous</span>
      </a>

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => {
        const href = pageNum === 1 ? '/' : `/page/${pageNum}/`;
        const isCurrent = pageNum === currentPage;
        return isCurrent ? (
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 text-sm font-semibold text-blue-700">
            {pageNum}
          </span>
        ) : (
          <a
            href={href}
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
          >
            {pageNum}
          </a>
        );
      })}

      {nextHref && (
        <a
          href={nextHref}
          class="inline-flex items-center gap-1 rounded-xl border border-gray-200 bg-white px-4 h-10 text-sm font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
        >
          <span>Next</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>
