---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_CONFIG } from '../../lib/site';
import { loadAllPosts } from '../../lib/posts';

export function getStaticPaths() {
  const allPosts = loadAllPosts();
  const remainingPosts = allPosts.slice(1);
  const perPage = SITE_CONFIG.postsPerPage;
  const totalPages = Math.ceil(remainingPosts.length / perPage);

  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * perPage;
    const pagePosts = remainingPosts.slice(start, start + perPage);
    paths.push({
      params: { page: String(page) },
      props: {
        posts: pagePosts,
        currentPage: page,
        totalPages,
      },
    });
  }
  return paths;
}

interface Props {
  posts: ReturnType<typeof loadAllPosts>;
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
const prevHref = currentPage === 2 ? '/' : `/page/${currentPage - 1}/`;
const nextHref = currentPage < totalPages ? `/page/${currentPage + 1}/` : null;
---

<BaseLayout
  title={`Blogs — Page ${currentPage}`}
  description={`Page ${currentPage} of ${totalPages} — DevOps and Cloud Engineering blogs by ${SITE_CONFIG.brandName}.`}
  breadcrumbs={[
    { name: 'Blogs', url: '/' },
    { name: `Page ${currentPage}` },
  ]}
>
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="mb-10 border-b border-slate-200/80 dark:border-slate-800 pb-6">
      <a href="/" class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-teal-700 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300">
        <span>&larr; ~/latest</span>
      </a>
      <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50">
        Engineering Archive &mdash; Page {currentPage}
      </h1>
      <p class="mt-1.5 font-mono text-xs text-slate-500 dark:text-slate-400">
        Page {currentPage} of {totalPages}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, idx) => (
        <PostCard post={post} index={idx} />
      ))}
    </div>

    <!-- Pagination -->
    <nav aria-label="Pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2">
      <a
        href={prevHref}
        class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 h-9 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-teal-50 dark:hover:bg-teal-950/50 hover:text-teal-800 dark:hover:text-teal-300 transition-colors"
      >
        <span aria-hidden="true">&larr;</span>
        <span>Previous</span>
      </a>

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => {
        const href = pageNum === 1 ? '/' : `/page/${pageNum}/`;
        const isCurrent = pageNum === currentPage;
        return isCurrent ? (
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-slate-900 dark:bg-teal-500 font-mono text-xs font-semibold text-white dark:text-slate-950">
            {pageNum}
          </span>
        ) : (
          <a
            href={href}
            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 font-mono text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-teal-50 dark:hover:bg-teal-950/50 hover:text-teal-800 dark:hover:text-teal-300 transition-colors"
          >
            {pageNum}
          </a>
        );
      })}

      {nextHref && (
        <a
          href={nextHref}
          class="inline-flex items-center gap-1 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 h-9 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-teal-50 dark:hover:bg-teal-950/50 hover:text-teal-800 dark:hover:text-teal-300 transition-colors"
        >
          <span>Next</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </nav>
  </div>
</BaseLayout>
