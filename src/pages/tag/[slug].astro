---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { loadAllPosts, getAllTags, slugifyTerm, type TaxonomyItem, type BlogPost } from '../../lib/posts';
import { getTagAccent } from '../../lib/colors';

export function getStaticPaths() {
  const allPosts = loadAllPosts();
  const tags = getAllTags();

  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      tag,
      posts: allPosts.filter((p) =>
        p.tags.some((t) => slugifyTerm(t) === tag.slug)
      ),
    },
  }));
}

interface Props {
  tag: TaxonomyItem;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
const accent = getTagAccent(tag.name);
---

<BaseLayout
  title={`Blogs tagged #${tag.name}`}
  description={`Read ${posts.length} DevOps and Cloud Engineering ${posts.length === 1 ? 'blog' : 'blogs'} tagged with ${tag.name} by Mahin Raza.`}
  breadcrumbs={[
    { name: 'Blogs', url: '/' },
    { name: 'Topics', url: '/tags/' },
    { name: tag.name },
  ]}
>
  <section class="border-b border-slate-200/80 bg-white py-12 sm:py-14">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <a
        href="/tags/"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-teal-700 hover:text-teal-800"
      >
        <span>&larr; ~/topics</span>
      </a>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center rounded-md border px-3 py-1 font-mono text-xs font-semibold ${accent.pill}`}>
          <span class="mr-0.5 opacity-60" aria-hidden="true">#</span>
          <span>{tag.name}</span>
        </span>
        <span class="font-mono text-xs text-slate-500">
          {posts.length} {posts.length === 1 ? 'blog' : 'blogs'}
        </span>
      </div>

      <h1 class="mt-4 font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
        Blogs tagged &ldquo;{tag.name}&rdquo;
      </h1>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, idx) => (
        <PostCard post={post} index={idx} />
      ))}
    </div>
  </div>
</BaseLayout>
