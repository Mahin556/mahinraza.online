---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { loadAllPosts, getAllTags, slugifyTerm, type TaxonomyItem, type BlogPost } from '../../lib/posts';
import { getTagAccent } from '../../lib/colors';

export function getStaticPaths() {
  const allPosts = loadAllPosts();
  const tags = getAllTags();

  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      tag,
      posts: allPosts.filter((p) =>
        p.tags.some((t) => slugifyTerm(t) === tag.slug)
      ),
    },
  }));
}

interface Props {
  tag: TaxonomyItem;
  posts: BlogPost[];
}

const { tag, posts } = Astro.props;
const accent = getTagAccent(tag.name);
---

<BaseLayout
  title={`Posts tagged "${tag.name}"`}
  description={`Read ${posts.length} DevOps and Cloud Engineering ${posts.length === 1 ? 'article' : 'articles'} tagged with ${tag.name} by Mahin Raza.`}
  breadcrumbs={[
    { name: 'Articles', url: '/' },
    { name: 'Tags', url: '/tags/' },
    { name: tag.name },
  ]}
>
  <section class="border-b border-gray-100 bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <a
        href="/tags/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500"
      >
        <span>&larr; All tags</span>
      </a>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm font-semibold ${accent.pill}`}>
          <span class={`h-2 w-2 rounded-full ${accent.dot}`} aria-hidden="true"></span>
          <span>{tag.name}</span>
        </span>
        <span class="text-sm font-medium text-gray-500">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </span>
      </div>

      <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
        Articles tagged &ldquo;{tag.name}&rdquo;
      </h1>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, idx) => (
        <PostCard post={post} index={idx} />
      ))}
    </div>
  </div>
</BaseLayout>
