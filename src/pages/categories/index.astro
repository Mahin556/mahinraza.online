---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllCategories } from '../../lib/posts';
import { getCardAccent } from '../../lib/colors';

const categories = getAllCategories();
---

<BaseLayout
  title="Categories"
  description="Browse DevOps, Cloud Engineering, Kubernetes, Observability, and SRE articles organized by category."
  breadcrumbs={[
    { name: 'Articles', url: '/' },
    { name: 'Categories' },
  ]}
>
  <section class="border-b border-gray-100 bg-white py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
          {categories.length} Categories
        </span>
        <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
          Browse by Category
        </h1>
        <p class="mt-3 text-base sm:text-lg leading-7 text-gray-600">
          Explore structured tracks covering AWS infrastructure, Kubernetes, OpenTelemetry, Prometheus, and Site Reliability Engineering.
        </p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {categories.map((cat, idx) => {
        const accent = getCardAccent(idx);
        return (
          <a
            href={`/category/${cat.slug}/`}
            class={`group relative flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 shadow-sm ring-1 ring-gray-100 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg ${accent.cardHover}`}
          >
            <div
              class={`pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-transparent to-transparent transition-all duration-300 ${accent.gradientOverlay}`}
              aria-hidden="true"
            ></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between gap-2">
                <h2 class={`text-xl font-bold tracking-tight text-gray-900 transition-colors ${accent.titleHover}`}>
                  {cat.name}
                </h2>
                <span class="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 px-2.5 py-0.5 text-xs font-semibold text-gray-700">
                  {cat.count} {cat.count === 1 ? 'post' : 'posts'}
                </span>
              </div>

              {cat.description && (
                <p class="mt-3 text-sm leading-6 text-gray-600">
                  {cat.description}
                </p>
              )}
            </div>

            <div class={`relative z-10 mt-6 inline-flex items-center gap-1 text-xs font-semibold ${accent.cta}`}>
              <span>View articles</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
