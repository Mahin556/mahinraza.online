---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { loadAllPosts, getAllCategories, type TaxonomyItem, type BlogPost } from '../../lib/posts';

export function getStaticPaths() {
  const allPosts = loadAllPosts();
  const categories = getAllCategories();

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      posts: allPosts.filter((p) => p.categorySlug === category.slug),
    },
  }));
}

interface Props {
  category: TaxonomyItem;
  posts: BlogPost[];
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={category.name}
  description={category.description || `Engineering guides in ${category.name} by Mahin Raza.`}
  breadcrumbs={[
    { name: 'Guides', url: '/' },
    { name: 'Categories', url: '/categories/' },
    { name: category.name },
  ]}
>
  <section class="border-b border-slate-200/80 bg-white py-12 sm:py-14">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <a
        href="/categories/"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-teal-700 hover:text-teal-800"
      >
        <span>&larr; ~/categories</span>
      </a>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <h1 class="font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
          {category.name}
        </h1>
        <span class="inline-flex items-center rounded-md border border-teal-200 bg-teal-50 px-2.5 py-1 font-mono text-xs font-medium text-teal-800">
          {posts.length} {posts.length === 1 ? 'guide' : 'guides'}
        </span>
      </div>

      {category.description && (
        <p class="mt-3 max-w-2xl text-base sm:text-lg leading-7 text-slate-600">
          {category.description}
        </p>
      )}
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, idx) => (
        <PostCard post={post} index={idx} />
      ))}
    </div>
  </div>
</BaseLayout>
