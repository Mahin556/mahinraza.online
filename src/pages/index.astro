---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import TagPills from '../components/TagPills.astro';
import { SITE_CONFIG } from '../lib/site';
import { loadAllPosts, getAllCategories, getAllTags } from '../lib/posts';

const allPosts = loadAllPosts();
const categories = getAllCategories();
const popularTags = getAllTags()
  .slice(0, 16)
  .map((t) => t.name);

const featuredPost = allPosts[0];
const remainingPosts = allPosts.slice(1);
const perPage = SITE_CONFIG.postsPerPage;
const firstPagePosts = remainingPosts.slice(0, perPage);
const totalPages = Math.max(1, Math.ceil(remainingPosts.length / perPage));

const coreStack = ['AWS', 'Kubernetes', 'OpenTelemetry', 'Prometheus', 'Terraform', 'SRE'];
---

<BaseLayout>
  <!-- Split Engineering Hero -->
  <section class="relative overflow-hidden border-b border-slate-200/80 bg-engineering-grid pt-10 pb-12 sm:pt-14 sm:pb-16">
    <!-- Soft fade mask over dot-grid -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-white/50 via-white/80 to-white"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-center">
        <!-- Left Column: Title, Bio, Search -->
        <div class="lg:col-span-7">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-md border border-teal-200 bg-teal-50/90 px-2.5 py-1 font-mono text-xs font-medium text-teal-800">
              <span class="h-1.5 w-1.5 rounded-full bg-teal-600" aria-hidden="true"></span>
              <span>~/engineering-notes &middot; {allPosts.length} blogs</span>
            </span>
          </div>

          <h1 class="mt-5 font-display text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
            Cloud Infrastructure, Kubernetes &amp;{' '}
            <span class="text-teal-700">Site Reliability</span>
          </h1>

          <p class="mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-slate-600">
            {SITE_CONFIG.description}
          </p>

          <!-- Quick Search Bar -->
          <div class="mt-7 max-w-xl">
            <button
              type="button"
              data-open-search
              class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-left text-sm text-slate-500 shadow-sm hover:border-teal-400 hover:shadow transition-all"
            >
              <span class="flex items-center gap-3 truncate">
                <svg class="h-4 w-4 shrink-0 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span class="truncate">Search {allPosts.length} blogs by topic, service, or error...</span>
              </span>
              <kbd class="hidden sm:inline-flex shrink-0 items-center rounded border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-400">
                ⌘K
              </kbd>
            </button>
          </div>
        </div>

        <!-- Right Column: Terminal Author / Focus Card -->
        <div class="lg:col-span-5">
          <div class="rounded-xl border border-slate-200/90 bg-white shadow-sm overflow-hidden">
            <!-- Terminal Window Bar -->
            <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50/90 px-4 py-2.5">
              <div class="flex items-center gap-1.5" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-teal-500"></span>
              </div>
              <span class="font-mono text-[11px] text-slate-400">whoami.yaml</span>
            </div>

            <div class="p-5 sm:p-6">
              <div class="flex items-center gap-3.5">
                <img
                  src={SITE_CONFIG.author.avatarUrl}
                  alt={SITE_CONFIG.author.name}
                  width="48"
                  height="48"
                  loading="eager"
                  decoding="async"
                  class="h-12 w-12 rounded-lg bg-slate-100 ring-1 ring-slate-200 object-cover"
                />
                <div>
                  <div class="font-display text-base font-bold text-slate-900">
                    {SITE_CONFIG.author.name}
                  </div>
                  <div class="font-mono text-xs text-teal-700">
                    {SITE_CONFIG.shortRole}
                  </div>
                </div>
              </div>

              <div class="mt-4">
                <div class="font-mono text-[11px] uppercase tracking-wider text-slate-400 mb-2">
                  Focus Areas
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {coreStack.map((item) => (
                    <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-[11px] font-medium text-slate-700">
                      {item}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-4 text-xs font-semibold">
                <a
                  href={SITE_CONFIG.portfolioUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-teal-700 hover:text-teal-800 transition-colors"
                >
                  <span>mahinraza.online</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
                <div class="flex items-center gap-3 text-slate-500">
                  <a
                    href={SITE_CONFIG.githubProfileUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-slate-900 transition-colors"
                  >
                    GitHub
                  </a>
                  <span class="text-slate-300" aria-hidden="true">&middot;</span>
                  <a href="/rss.xml" class="hover:text-amber-600 transition-colors">
                    RSS
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-8 pt-6 border-t border-slate-200/70 flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-xs font-medium text-slate-400">Tracks:</span>
        <a
          href="/"
          class="inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white"
        >
          <span>All</span>
          <span class="font-mono text-[11px] text-teal-300">{allPosts.length}</span>
        </a>
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}/`}
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:border-teal-300 hover:bg-teal-50/70 hover:text-teal-800 transition-colors"
          >
            <span>{cat.name}</span>
            <span class="font-mono text-[11px] text-slate-400">{cat.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <!-- Featured Post -->
    {featuredPost && (
      <section aria-label="Featured blog" class="mb-14">
        <FeaturedPost post={featuredPost} />
      </section>
    )}

    <!-- Latest Articles Grid -->
    <section aria-labelledby="latest-articles-heading">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-slate-200/80 pb-4">
        <div>
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-700">
            // Archive
          </div>
          <h2 id="latest-articles-heading" class="mt-1 font-display text-2xl font-bold tracking-tight text-slate-900">
            Recent Blogs
          </h2>
        </div>
        <a
          href="/categories/"
          class="text-xs sm:text-sm font-semibold text-teal-700 hover:text-teal-800 transition-colors"
        >
          View all categories &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
        {firstPagePosts.map((post, idx) => (
          <PostCard post={post} index={idx} />
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav aria-label="Pagination" class="mt-12 flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-slate-900 font-mono text-xs font-semibold text-white">
            1
          </span>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNum) => (
            <a
              href={`/page/${pageNum}/`}
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white font-mono text-xs font-medium text-slate-700 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800 transition-colors"
            >
              {pageNum}
            </a>
          ))}
          <a
            href="/page/2/"
            class="inline-flex items-center gap-1 rounded-lg border border-slate-200 bg-white px-3.5 h-9 text-xs font-semibold text-slate-700 hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800 transition-colors"
          >
            <span>Next</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </nav>
      )}
    </section>

    <!-- Popular Tags Strip -->
    {popularTags.length > 0 && (
      <section aria-labelledby="popular-tags-heading" class="mt-16 rounded-xl border border-slate-200/90 bg-white p-6 sm:p-8 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <div>
            <span class="font-mono text-[11px] uppercase tracking-wider text-teal-700">// Index</span>
            <h2 id="popular-tags-heading" class="font-display text-base font-bold tracking-tight text-slate-900">
              Popular Engineering Topics
            </h2>
          </div>
          <a href="/tags/" class="text-xs font-semibold text-teal-700 hover:text-teal-800">
            Browse all topics &rarr;
          </a>
        </div>
        <TagPills tags={popularTags} size="md" />
      </section>
    )}
  </div>
</BaseLayout>
