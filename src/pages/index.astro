---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import TagPills from '../components/TagPills.astro';
import { SITE_CONFIG } from '../lib/site';
import { loadAllPosts, getAllCategories, getAllTags } from '../lib/posts';

const allPosts = loadAllPosts();
const categories = getAllCategories();
const popularTags = getAllTags()
  .slice(0, 14)
  .map((t) => t.name);

const featuredPost = allPosts[0];
const remainingPosts = allPosts.slice(1);
const perPage = SITE_CONFIG.postsPerPage;
const firstPagePosts = remainingPosts.slice(0, perPage);
const totalPages = Math.max(1, Math.ceil(remainingPosts.length / perPage));
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-gray-100 bg-white pt-12 pb-12 sm:pt-16 sm:pb-14">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Top Pill + RSS -->
        <div class="inline-flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 text-xs font-semibold text-blue-700">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
            <span>{allPosts.length} Technical Guides</span>
          </span>
          <a
            href="/rss.xml"
            class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-600 hover:border-orange-200 hover:bg-orange-50 hover:text-orange-700 transition-colors"
          >
            <svg class="h-3.5 w-3.5 text-orange-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
            </svg>
            <span>RSS</span>
          </a>
        </div>

        <!-- Headline -->
        <h1 class="mt-6 text-3xl sm:text-5xl font-extrabold tracking-tight text-gray-900 leading-tight">
          {SITE_CONFIG.title}{' '}
          <span class="block sm:inline text-blue-600 font-bold">
            {SITE_CONFIG.subtitle}
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg leading-8 text-gray-600">
          {SITE_CONFIG.description}
        </p>

        <!-- Inline Quick Search Trigger -->
        <div class="mt-8 mx-auto max-w-xl">
          <button
            type="button"
            data-open-search
            class="flex w-full items-center justify-between rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 text-left text-sm text-gray-500 shadow-sm ring-1 ring-gray-100 hover:border-blue-300 hover:bg-white hover:shadow transition-all"
          >
            <span class="flex items-center gap-3">
              <svg class="h-5 w-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span>Search {allPosts.length} articles by topic, command, or tag...</span>
            </span>
            <kbd class="hidden sm:inline-flex items-center rounded-md border border-gray-200 bg-white px-2 py-0.5 font-mono text-xs font-medium text-gray-400">
              ⌘K
            </kbd>
          </button>
        </div>

        <!-- Category Quick Links -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1.5 text-xs font-semibold text-blue-700"
          >
            All ({allPosts.length})
          </a>
          {categories.map((cat) => (
            <a
              href={`/category/${cat.slug}/`}
              class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3.5 py-1.5 text-xs font-medium text-gray-600 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            >
              <span>{cat.name}</span>
              <span class="text-gray-400">({cat.count})</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <!-- Featured Post -->
    {featuredPost && (
      <section aria-label="Featured article" class="mb-14">
        <FeaturedPost post={featuredPost} />
      </section>
    )}

    <!-- Latest Articles Grid -->
    <section aria-labelledby="latest-articles-heading">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 id="latest-articles-heading" class="text-2xl font-bold tracking-tight text-gray-900">
            Latest Engineering Guides
          </h2>
          <p class="mt-1 text-sm text-gray-500">
            Deep dives into cloud infrastructure, Kubernetes, observability, and reliability.
          </p>
        </div>
        <a
          href="/categories/"
          class="text-sm font-semibold text-blue-600 hover:text-blue-500 transition-colors"
        >
          Browse by category &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {firstPagePosts.map((post, idx) => (
          <PostCard post={post} index={idx} />
        ))}
      </div>

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-2">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-blue-200 bg-blue-50 text-sm font-semibold text-blue-700">
            1
          </span>
          {Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((pageNum) => (
            <a
              href={`/page/${pageNum}/`}
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-white text-sm font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            >
              {pageNum}
            </a>
          ))}
          <a
            href="/page/2/"
            class="inline-flex items-center gap-1 rounded-xl border border-gray-200 bg-white px-4 h-10 text-sm font-medium text-gray-700 hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 transition-colors"
          >
            <span>Next</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </nav>
      )}
    </section>

    <!-- Popular Tags Strip -->
    {popularTags.length > 0 && (
      <section aria-labelledby="popular-tags-heading" class="mt-16 rounded-2xl border border-gray-200 bg-gray-50/50 p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
          <h2 id="popular-tags-heading" class="text-base font-bold tracking-tight text-gray-900">
            Explore Popular Topics
          </h2>
          <a href="/tags/" class="text-xs font-semibold text-blue-600 hover:text-blue-500">
            View all tags &rarr;
          </a>
        </div>
        <TagPills tags={popularTags} size="md" />
      </section>
    )}
  </div>
</BaseLayout>
