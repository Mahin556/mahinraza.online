---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPills from '../../components/TagPills.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PostCard from '../../components/PostCard.astro';
import { loadAllPosts, getRelatedPosts, type BlogPost } from '../../lib/posts';
import { renderPostMarkdown } from '../../lib/markdown';
import { SITE_CONFIG } from '../../lib/site';

export function getStaticPaths() {
  const posts = loadAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { html, toc } = await renderPostMarkdown(
  post.body,
  post.slug,
  post.isDirectoryPost
);
const relatedPosts = getRelatedPosts(post, 3);

const canonicalPostUrl = `${SITE_CONFIG.siteUrl}/posts/${post.slug}/`;
const encodedUrl = encodeURIComponent(canonicalPostUrl);
const encodedTitle = encodeURIComponent(post.title);

const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const hnShareUrl = `https://news.ycombinator.com/submitlink?u=${encodedUrl}&t=${encodedTitle}`;
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogImage={post.ogImage}
  ogType="article"
  publishedTime={post.dateISO}
  modifiedTime={post.dateISO}
  authorName={post.author.name}
  authorUrl={post.author.githubUrl}
  tags={post.tags}
  canonicalPath={`/posts/${post.slug}/`}
  breadcrumbs={[
    { name: 'Blogs', url: '/' },
    { name: post.category, url: `/category/${post.categorySlug}/` },
    { name: post.title },
  ]}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

  <!-- Article Hero -->
  <header class="border-b border-slate-200/80 dark:border-slate-800/90 bg-white dark:bg-[#0d1426] pt-10 pb-10 sm:pt-12 sm:pb-12">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <!-- Breadcrumb & Metadata -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-slate-400 dark:text-slate-500">
        <a href="/" class="text-slate-500 dark:text-slate-400 hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
          ~/blogs
        </a>
        <span aria-hidden="true">/</span>
        <a
          href={`/category/${post.categorySlug}/`}
          class="font-medium text-teal-700 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300 transition-colors"
        >
          {post.categorySlug}
        </a>
        <span class="hidden sm:inline text-slate-300 dark:text-slate-700" aria-hidden="true">&middot;</span>
        <span class="hidden sm:inline text-slate-500 dark:text-slate-400">
          <time datetime={post.dateISO}>{post.formattedDate}</time> &middot; {post.readingTimeText}
        </span>
      </div>

      <!-- Title -->
      <h1 class="mt-4 max-w-4xl font-display text-3xl sm:text-4xl md:text-[42px] font-extrabold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.18]">
        {post.title}
      </h1>

      <!-- Summary -->
      <p class="mt-4 max-w-3xl text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {post.description}
      </p>

      <!-- Tags -->
      <div class="mt-5">
        <TagPills tags={post.tags} size="sm" />
      </div>

      <!-- Author & Share Bar -->
      <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-slate-100 dark:border-slate-800 pt-5">
        <a
          href={post.author.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 group"
        >
          <img
            src={post.author.avatarUrl}
            alt={post.author.name}
            width="38"
            height="38"
            loading="eager"
            decoding="async"
            class="h-9 w-9 rounded-lg bg-slate-100 dark:bg-slate-800 ring-1 ring-slate-200 dark:ring-slate-700 object-cover"
          />
          <div>
            <div class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-teal-700 dark:group-hover:text-teal-400 transition-colors">
              {post.author.name}
            </div>
            <div class="font-mono text-[11px] text-slate-500 dark:text-slate-400 sm:hidden">
              <time datetime={post.dateISO}>{post.formattedDate}</time> &middot; {post.readingTimeText}
            </div>
            <div class="hidden sm:block font-mono text-[11px] text-slate-500 dark:text-slate-400">
              @{post.author.username} &middot; {SITE_CONFIG.shortRole}
            </div>
          </div>
        </a>

        <!-- Compact Header Share Controls -->
        <div class="flex items-center gap-1.5">
          <a
            href={twitterShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X"
            title="Share on X"
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href={linkedinShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
            title="Share on LinkedIn"
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
            </svg>
          </a>
          <button
            type="button"
            data-copy-post-link={canonicalPostUrl}
            class="copy-link-btn inline-flex h-8 items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-2.5 font-mono text-[11px] font-medium text-slate-600 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span data-copy-label>Copy URL</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Article Body + Desktop TOC -->
  <div class="mx-auto max-w-7xl px-6 py-10 sm:py-12 lg:px-8">
    <div class="mx-auto flex max-w-5xl items-start justify-between gap-12">
      <!-- Main Article Column -->
      <div class="min-w-0 max-w-3xl flex-1 rounded-xl border border-slate-200/80 dark:border-slate-800/90 bg-white dark:bg-slate-900/75 p-6 sm:p-10 shadow-[0_1px_3px_rgba(15,23,42,0.03)] dark:shadow-[0_12px_32px_rgba(2,6,23,0.4)]">
        <!-- Mobile / Tablet Collapsible TOC -->
        <TableOfContents items={toc} variant="mobile" />

        <!-- Rendered Markdown Body -->
        <article id="article-body" class="blog-body" set:html={html} />

        <!-- Bottom Share & Edit Strip -->
        <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 dark:border-slate-800 pt-6">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mr-1">
              Share:
            </span>
            <a
              href={twitterShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
            >
              X / Twitter
            </a>
            <a
              href={linkedinShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
            >
              LinkedIn
            </a>
            <a
              href={hnShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-amber-300 dark:hover:border-amber-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-amber-700 dark:hover:text-amber-400 transition-colors"
            >
              Hacker News
            </a>
            <button
              type="button"
              data-copy-post-link={canonicalPostUrl}
              class="copy-link-btn inline-flex items-center rounded-lg border border-slate-200 dark:border-slate-700/90 bg-slate-50 dark:bg-slate-800/80 px-3 py-1.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-white dark:hover:bg-slate-800 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
            >
              <span data-copy-label>Copy link</span>
            </button>
          </div>

          <a
            href={post.githubEditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 font-mono text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Source on GitHub</span>
          </a>
        </div>

        <!-- Author Bio Card -->
        <div class="mt-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-950/60 p-5 sm:p-6">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <img
              src={post.author.avatarUrl}
              alt={post.author.name}
              width="56"
              height="56"
              loading="lazy"
              decoding="async"
              class="h-14 w-14 rounded-lg bg-white dark:bg-slate-800 ring-1 ring-slate-200 dark:ring-slate-700 object-cover"
            />
            <div class="flex-1">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-400">
                    // Author
                  </span>
                  <h2 class="font-display text-base font-bold text-slate-900 dark:text-slate-100">
                    {post.author.name}
                  </h2>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href={SITE_CONFIG.portfolioUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-lg border border-teal-200 dark:border-teal-800/80 bg-teal-50/80 dark:bg-teal-950/50 px-3 py-1.5 font-mono text-xs font-medium text-teal-800 dark:text-teal-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:bg-teal-100/70 dark:hover:bg-teal-900/60 transition-colors"
                  >
                    <span>Portfolio</span>
                    <span aria-hidden="true">&nearr;</span>
                  </a>
                  <a
                    href={post.author.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3 py-1.5 font-mono text-xs font-medium text-slate-700 dark:text-slate-300 hover:border-teal-300 dark:hover:border-teal-500/60 hover:text-teal-700 dark:hover:text-teal-300 transition-colors"
                  >
                    <span>@{post.author.username}</span>
                  </a>
                </div>
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                {post.author.bio}
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Desktop Sticky TOC -->
      <TableOfContents items={toc} variant="desktop" />
    </div>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section aria-labelledby="related-posts-heading" class="mx-auto max-w-5xl mt-16 border-t border-slate-200 dark:border-slate-800 pt-12">
        <div class="flex items-end justify-between gap-4 mb-6">
          <div>
            <div class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-400">
              // Continue Reading
            </div>
            <h2 id="related-posts-heading" class="mt-1 font-display text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
              Related Blogs
            </h2>
          </div>
          <a href="/" class="text-xs sm:text-sm font-semibold text-teal-700 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300">
            All blogs &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {relatedPosts.map((relPost, idx) => (
            <PostCard post={relPost} index={idx} />
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- Back to Top Button -->
  <button
    type="button"
    id="back-to-top"
    class="back-to-top"
    aria-label="Scroll back to top"
  >
    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
    </svg>
  </button>

  <!-- Image Lightbox Overlay -->
  <div id="blog-lightbox" class="blog-lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image preview">
    <button type="button" id="blog-lightbox-close" class="blog-lightbox-close" aria-label="Close image preview">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <img id="blog-lightbox-img" src="" alt="" />
  </div>

  <script is:inline>
    (function () {
      const progressBar = document.getElementById('reading-progress');
      const articleBody = document.getElementById('article-body');
      const backToTopBtn = document.getElementById('back-to-top');

      // 1. Reading progress & Back-to-top visibility
      function onScroll() {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        if (articleBody && progressBar) {
          const rect = articleBody.getBoundingClientRect();
          const articleTop = rect.top + scrollTop;
          const total = Math.max(1, articleBody.offsetHeight - window.innerHeight * 0.6);
          const pct = Math.min(100, Math.max(0, ((scrollTop - articleTop + 120) / total) * 100));
          progressBar.style.width = pct + '%';
        }
        if (backToTopBtn) {
          backToTopBtn.classList.toggle('visible', scrollTop > 500);
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 2. Active Table of Contents scroll-spy
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      if (tocLinks.length > 0 && articleBody) {
        const headings = Array.from(articleBody.querySelectorAll('h2[id], h3[id]'));
        function updateActiveToc() {
          let activeId = headings[0] ? headings[0].id : '';
          for (const h of headings) {
            if (h.getBoundingClientRect().top <= 140) {
              activeId = h.id;
            } else {
              break;
            }
          }
          tocLinks.forEach((link) => {
            const match = link.getAttribute('data-toc-link') === activeId;
            link.classList.toggle('toc-active', match);
          });
        }
        window.addEventListener('scroll', updateActiveToc, { passive: true });
        updateActiveToc();
      }

      // 3. Copy code buttons
      document.querySelectorAll('.code-copy-btn').forEach((btn) => {
        btn.addEventListener('click', async function () {
          const pre = btn.closest('pre');
          const codeEl = pre ? pre.querySelector('code') : null;
          if (!codeEl) return;
          const labelSpan = btn.querySelector('span');
          try {
            await navigator.clipboard.writeText(codeEl.innerText || codeEl.textContent || '');
            btn.classList.add('copied');
            if (labelSpan) labelSpan.textContent = 'Copied!';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (labelSpan) labelSpan.textContent = 'Copy';
            }, 2000);
          } catch {
            btn.classList.add('copy-failed');
            if (labelSpan) labelSpan.textContent = 'Failed';
            setTimeout(() => {
              btn.classList.remove('copy-failed');
              if (labelSpan) labelSpan.textContent = 'Copy';
            }, 2000);
          }
        });
      });

      // 4. Copy article link buttons
      document.querySelectorAll('[data-copy-post-link]').forEach((btn) => {
        btn.addEventListener('click', async function () {
          const url = btn.getAttribute('data-copy-post-link') || window.location.href;
          const label = btn.querySelector('[data-copy-label]');
          const prevText = label ? label.textContent : 'Copy link';
          try {
            await navigator.clipboard.writeText(url);
            btn.classList.add('copied');
            if (label) label.textContent = 'Copied!';
            setTimeout(() => {
              btn.classList.remove('copied');
              if (label) label.textContent = prevText;
            }, 2000);
          } catch {
            btn.classList.add('copy-failed');
            setTimeout(() => btn.classList.remove('copy-failed'), 2000);
          }
        });
      });

      // 5. Image Lightbox
      const lightbox = document.getElementById('blog-lightbox');
      const lightboxImg = document.getElementById('blog-lightbox-img');
      const lightboxClose = document.getElementById('blog-lightbox-close');

      if (articleBody && lightbox && lightboxImg) {
        articleBody.querySelectorAll('img').forEach((img) => {
          img.addEventListener('click', () => {
            lightboxImg.src = img.src;
            lightboxImg.alt = img.alt || '';
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
          });
        });

        function closeLightbox() {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
        }

        lightbox.addEventListener('click', closeLightbox);
        if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && lightbox.classList.contains('active')) {
            closeLightbox();
          }
        });
      }
    })();
  </script>
</BaseLayout>
